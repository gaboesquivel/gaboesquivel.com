
## Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=

# For redirects
EDGE_CONFIG=

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel AI Gateway — normal path for Eve, semantic GenUI, and Jev
AI_GATEWAY_API_KEY=

# Optional model override (Gateway model id)
# EVE_AGENT_MODEL=anthropic/claude-sonnet-5.5

# Local only: direct Anthropic when AI_GATEWAY_API_KEY is unset (set FLOW_ALLOW_DIRECT_ANTHROPIC=1)
# FLOW_ALLOW_DIRECT_ANTHROPIC=1
# ANTHROPIC_API_KEY=

# Vercel /ask caps (Upstash Redis marketplace). Optional locally (in-memory fallback).
# UPSTASH_REDIS_REST_URL=   # or KV_REST_API_URL from the marketplace integration
# UPSTASH_REDIS_REST_TOKEN= # or KV_REST_API_TOKEN
# CONNECT_ENFORCE_CAPS=1    # enforce chat/book/note caps on localhost and gaboesquivel.localhost

# Google Calendar (/ask booking). Domain-wide delegation; no visitor OAuth.
# 1. GCP project gabo-esquivel: enable Calendar API, service account gaboesquivel-ask-booking, JSON key.
# 2. Google Admin: domain-wide delegation for the service account client id with scopes
#    https://www.googleapis.com/auth/calendar.events and calendar.freebusy.
# 3. Same vars locally and on Vercel Production + Preview:
# GOOGLE_CALENDAR_ID=contact@gaboesquivel.com
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
