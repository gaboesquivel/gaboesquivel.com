{
  "private": true,
  "scripts": {
    "dev": "portless",
    "dev:app": "sh -c 'ulimit -n 10240 2>/dev/null; bun scripts/export-llms.ts; exec bunx concurrently -k \"velite --watch\" \"next dev -p 3099\"'",
    "setup:portless": "portless trust && portless proxy start",
    "content:build": "velite",
    "content:watch": "velite --watch",
    "build": "velite && bun scripts/export-llms.ts && next build",
    "export:llms": "bun scripts/export-llms.ts",
    "test:llms": "bun test scripts/llms/export-llms.test.ts scripts/llms/markdown-corpus.test.ts lib/accept-markdown.test.ts lib/markdown-api-path.test.ts lib/blog-taxonomy.test.ts lib/blog-order.test.ts scripts/cv-page-breaks.test.ts lib/connect/gate.test.ts lib/connect/rank.test.ts lib/connect/ask.test.ts lib/connect/routing.test.ts",
    "cvs": "bun scripts/export-cv.ts",
    "start": "next start",
    "verify": "bun run content:build && bun run lint",
    "verify:routes": "sh scripts/verify-routes.sh",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "hooks:cvs-if-needed": "sh scripts/hooks/cvs-if-needed.sh",
    "hooks:pre-commit": "sh -c 'set -eu; staged=$(git diff --cached --name-only --diff-filter=ACMR); if [ -n \"$staged\" ]; then printf \"%s\\n\" \"$staged\" | xargs bun x ultracite fix; fi' && bun run hooks:cvs-if-needed && git update-index --again",
    "skills:install": "bunx skills@latest experimental_install",
    "skills:update": "bunx skills@latest update -p -y"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-form": "^1.33.5",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "^1.5.1",
    "ai": "^7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "eve": "^0.80.1",
    "gaboesquivel": "^7.2.0",
    "lucide-react": "1.59.0",
    "motion": "^14.3.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tweet": "^3.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "velite": "^0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.64.1",
    "portless": "^0.15.8",
    "postcss": "^8.5.31",
    "remark-parse": "^11.0.0",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1",
    "unified": "^11.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run hooks:pre-commit"
  },
  "engines": {
    "node": "24.x"
  },
  "portless": {
    "name": "gaboesquivel",
    "script": "dev:app",
    "appPort": 3099
  }
}
