    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "concurrently": "^10.0.6",
    "knip": "^6.45.0",
    "opentype.js": "^2.0.0",
    "oxfmt": "^0.71.0",
