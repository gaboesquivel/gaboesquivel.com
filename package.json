{
  "private": true,
  "scripts": {
    "dev": "portless",
    "dev:app": "sh -c 'ulimit -n 10240 2>/dev/null; bun scripts/export-llms.ts; exec bunx concurrently -k \"velite --watch\" \"next dev -p 3099\"'",
    "setup:portless": "portless trust && portless proxy start",
    "content:build": "velite",
    "content:watch": "velite --watch",
    "build": "velite && bun scripts/export-llms.ts && next build",
    "export:llms": "bun scripts/export-llms.ts",
    "test:llms": "bun test scripts/llms/export-llms.test.ts scripts/llms/markdown-corpus.test.ts lib/accept-markdown.test.ts lib/markdown-api-path.test.ts lib/blog-taxonomy.test.ts lib/blog-order.test.ts scripts/cv-page-breaks.test.ts",
    "cvs": "bun scripts/export-cv.ts",
    "start": "next start",
    "verify": "bun run content:build && bun run lint",
    "verify:routes": "sh scripts/verify-routes.sh",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "hooks:cvs-if-needed": "sh scripts/hooks/cvs-if-needed.sh",
    "hooks:pre-commit": "sh -c 'set -eu; staged=$(git diff --cached --name-only --diff-filter=ACMR); if [ -n \"$staged\" ]; then printf \"%s\\n\" \"$staged\" | xargs bun x ultracite fix; fi' && bun run hooks:cvs-if-needed && git update-index --again",
    "skills:install": "bunx skills@latest experimental_install",
    "skills:update": "bunx skills@latest update -p -y"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "^1.5.1",
    "clsx": "^2.0.0",
    "gaboesquivel": "^7.2.0",
    "lucide-react": "0.476.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-tweet": "^3.3.1",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^2.3.0",
    "velite": "^0.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.55.0",
    "portless": "^0.15.8",
    "postcss": "^8.4.29",
    "remark-parse": "^11.0.0",
    "simple-git-hooks": "2.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "ultracite": "8.0.1",
    "unified": "^11.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run hooks:pre-commit"
  },
  "engines": {
    "node": "24.x"
  },
  "portless": {
    "name": "gaboesquivel",
    "script": "dev:app",
    "appPort": 3099
  }
}
