{
  "private": true,
  "scripts": {
    "dev": "portless",
    "dev:app": "sh -c 'ulimit -n 10240 2>/dev/null; rm -rf .next; bun scripts/export-llms.ts; exec bunx concurrently -k \"velite --watch\" \"next dev -p 3099\"'",
    "setup:portless": "portless trust && sudo -v && portless proxy start",
    "content:build": "velite",
    "prepare:generated": "velite && bun scripts/export-llms.ts",
    "content:watch": "velite --watch",
    "build": "velite && bun scripts/generate-og.ts && bun scripts/export-llms.ts && next build",
    "export:llms": "bun scripts/export-llms.ts",
    "test:llms": "bun scripts/export-llms.ts && bun test scripts/export-api-static.test.ts scripts/llms/export-llms.test.ts scripts/llms/markdown-corpus.test.ts lib/accept-markdown.test.ts lib/markdown-api-path.test.ts lib/blog-taxonomy.test.ts lib/blog-order.test.ts lib/blog-pagination.test.ts lib/og/resolve.test.ts scripts/cv-page-breaks.test.ts lib/connect/cv-download.test.ts lib/connect/gate.test.ts lib/connect/rank.test.ts lib/connect/ask.test.ts lib/connect/work-cards.test.ts lib/connect/routing.test.ts lib/connect/calendar-auth.test.ts lib/connect/calendar-errors.test.ts lib/connect/note-form-visible.test.ts lib/mcp/cv-app.test.ts lib/api/openapi.test.ts lib/api/problem.test.ts lib/api/markdown-corpus.test.ts lib/api/routes.test.ts app/contact/contact-page.test.ts lib/capabilities/published-copy.test.ts",
    "cvs": "bun scripts/export-cv.ts",
    "start": "next start",
    "verify": "bun run content:build && bun run lint && bun run check:motion",
    "check:motion": "bun scripts/check-motion-stack.ts",
    "verify:routes": "sh scripts/verify-routes.sh",
    "verify:calendar": "bun scripts/verify-google-calendar.ts",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "bun x oxfmt",
    "qa": "bun run lint:fix && bun run format && bun run build",
    "hooks:cvs-if-needed": "sh scripts/hooks/cvs-if-needed.sh",
    "hooks:pre-commit": "bun run qa && bun run hooks:cvs-if-needed && git update-index --again",
    "prepare": "simple-git-hooks",
    "skills:install": "bunx skills@latest experimental_install",
    "skills:update": "bunx skills@latest update -p -y",
    "og:generate": "velite && bun scripts/generate-og.ts",
    "hero:optimize": "bun scripts/optimize-home-hero.ts",
    "test:genui": "bun run test:genui:unit && bun run test:genui:mcp-apps && bun run test:genui:browser",
    "test:genui:unit": "bun test lib/genui lib/mcp/public-protocol.test.ts tests/genui/contracts tests/genui/unit",
    "eval:genui:matrix": "bun scripts/eval-genui-matrix.ts",
    "test:genui:mcp-apps": "bun run test:genui:mcp-apps:protocol && bun run test:genui:mcp-apps:host",
    "test:genui:mcp-apps:protocol": "bun test lib/mcp/public-protocol.test.ts",
    "test:genui:mcp-apps:host": "playwright test tests/genui/mcp-apps/browser/simulated-host.spec.ts",
    "test:genui:mcp-apps:basic-host": "playwright test tests/genui/mcp-apps/browser/basic-host.spec.ts",
    "mcp-apps:ensure-basic-host": "node scripts/mcp-apps/ensure-basic-host.mjs",
    "mcp-apps:test-server": "bun scripts/mcp-apps/test-mcp-server.ts",
    "test:genui:browser": "playwright test tests/genui/browser/functional",
    "test:genui:visual": "playwright test tests/genui/browser/visual",
    "test:genui:a11y": "playwright test tests/genui/browser/accessibility",
    "eval:genui": "bun run eval:genui:offline",
    "eval:genui:offline": "bun scripts/eval-genui-offline.ts",
    "eval:genui:live": "GENUI_EVAL_LIVE=1 promptfoo eval -c promptfooconfig.yaml"
  },
